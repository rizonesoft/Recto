# Derived output: always reproducible from the tracked sources. The tracked
# files under build/ are Recto's one-command build driver at build/build.ps1
# and the helpers it loads (asan-runtime.ps1, msbuild-log.ps1, parallelism.ps1,
# build-evidence.ps1).
build/*
!build/build.ps1
!build/asan-runtime.ps1
!build/msbuild-log.ps1
!build/parallelism.ps1
!build/build-evidence.ps1
!build/tools.lock.json
!build/bootstrap-tools.ps1
!build/python.cmd
__pycache__/
*.pyc

# vcpkg manifest installs: derived from vcpkg.json on every machine
vcpkg_installed/

# Visual Studio and MSBuild output (lands with the M0 scaffold, D00 T01 §3).
.vs/
[Bb]in/
[Oo]bj/
[Gg]enerated Files/
*.user
*.suo

# Local tooling state.
.tools/
.cache/

# Crash dumps hold process memory (document content, credentials): never committable.
*.dmp
*.mdmp
