# Derived output: always reproducible from the tracked sources. The one
# tracked file under build/ is Recto's MuPDF feature config, which the
# foundation plan (section 3.2) places at build/mupdf-config.h.
build/*
!build/mupdf-config.h
!build/mupdf-win32.targets
!build/build-mupdf.ps1
!build/build.ps1
__pycache__/
*.pyc

# vcpkg manifest installs: derived from vcpkg.json on every machine
vcpkg_installed/

# Visual Studio and MSBuild output (lands with the M0 scaffold, D00 T01 §3).
.vs/
[Bb]in/
[Oo]bj/
[Gg]enerated Files/
*.user
*.suo

# Local tooling state.
.tools/
