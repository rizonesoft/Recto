# Derived output: always reproducible from the tracked sources. The one
# tracked files under build/ are Recto's one-command build driver at
# build/build.ps1 and the ASan runtime staging it loads, build/asan-runtime.ps1.
build/*
!build/build.ps1
!build/asan-runtime.ps1
__pycache__/
*.pyc

# vcpkg manifest installs: derived from vcpkg.json on every machine
vcpkg_installed/

# Visual Studio and MSBuild output (lands with the M0 scaffold, D00 T01 §3).
.vs/
[Bb]in/
[Oo]bj/
[Gg]enerated Files/
*.user
*.suo

# Local tooling state.
.tools/

# Crash dumps hold process memory (document content, credentials): never committable.
*.dmp
*.mdmp
