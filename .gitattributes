# The generated plan is byte-compared by plan --check, the tooling parses
# Markdown strictly, and LICENSE must stay byte-identical to the FSF text:
# keep text sources LF on every platform.
LICENSE text eol=lf
.gitattributes text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.svg text eol=lf
# Visual Studio and cmd files keep CRLF, which their tools write and expect.
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.cmd text eol=crlf
*.pdf binary
*.png binary
*.ico binary
*.docx binary
*.xlsx binary
*.bin binary
*.ttf binary
*.otf binary
*.pfa binary
*.pfb binary
*.cff binary
# Byte-exact compressor fixtures (their SHA-256 is recorded in reference-sizes.json).
tests/corpus/flate/*.txt binary
scripts/hooks/* text eol=lf
# Vendored Adobe Core14 AFM files and their notice stay byte for byte as published (src/pdf/adobe-core14-afm/README.md).
src/pdf/adobe-core14-afm/*.afm -text
src/pdf/adobe-core14-afm/MustRead.html -text
# The vendored Adobe Glyph List files too (src/pdf/adobe-glyph-list/README.md).
src/pdf/adobe-glyph-list/*.txt -text
# The Annex D transcription and the Macintosh glyph names: LF everywhere, as the tooling tests edit them by line.
src/pdf/pdf-encodings/*.txt text eol=lf
