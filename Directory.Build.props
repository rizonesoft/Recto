<?xml version="1.0" encoding="utf-8"?>
<!-- Shared compiler rules for all Recto projects (decision D14).
     Every module in Recto.sln is authored in-tree and subject to the
     zero-warning bar (/W4 /WX). -->
<Project>
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('recto-')) Or '$(MSBuildProjectName)' == 'Recto'">
    <PlatformToolset Condition="'$(PlatformToolset)' == '' and Exists('$(VCTargetsPath)Platforms\x64\PlatformToolsets\v145')">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.22621.0</WindowsTargetPlatformMinVersion>
    <CharacterSet>Unicode</CharacterSet>
    <EnableASAN Condition="'$(EnableASAN)' == ''">false</EnableASAN>
    <!-- Compile flags (warning level, language standards, runtime) are
         ClCompile item metadata in VC projects, not properties; they live
         in Directory.Build.targets next to this file. -->
    <OutDir>$(MSBuildThisFileDirectory)build\bin\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)build\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
</Project>
