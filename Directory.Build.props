<?xml version="1.0" encoding="utf-8"?>
<!-- Shared compiler rules for all Recto projects (decision D14).
     Every module in Recto.sln is authored in-tree and subject to the
     zero-warning bar (/W4 /WX). -->
<Project>
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('recto-')) Or '$(MSBuildProjectName)' == 'Recto'">
    <PlatformToolset>v145</PlatformToolset>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.22621.0</WindowsTargetPlatformMinVersion>
    <CharacterSet>Unicode</CharacterSet>
    <EnableASAN Condition="'$(EnableASAN)' == ''">false</EnableASAN>
    <LinkIncremental Condition="'$(EnableASAN)' == 'true'">false</LinkIncremental>
    <!-- Compile flags (warning level, language standards, runtime) are
         ClCompile item metadata in VC projects, not properties; they live
         in Directory.Build.targets next to this file. -->
    <!-- An ASan build has folders of its own, so switching between it and the plain build rebuilds nothing (D00 T04 §1). -->
    <RectoBinFolder Condition="'$(EnableASAN)' == 'true'">bin-asan</RectoBinFolder>
    <RectoBinFolder Condition="'$(EnableASAN)' != 'true'">bin</RectoBinFolder>
    <RectoObjFolder Condition="'$(EnableASAN)' == 'true'">obj-asan</RectoObjFolder>
    <RectoObjFolder Condition="'$(EnableASAN)' != 'true'">obj</RectoObjFolder>
    <OutDir>$(MSBuildThisFileDirectory)build\$(RectoBinFolder)\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)build\$(RectoObjFolder)\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
</Project>
