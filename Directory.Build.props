<?xml version="1.0" encoding="utf-8"?>
<!-- Shared compiler rules for all Recto projects (decision D14).
     Every module in Recto.sln is authored in-tree and subject to the
     zero-warning bar (/W4 /WX). -->
<Project>
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('recto-')) Or '$(MSBuildProjectName)' == 'Recto'">
    <PlatformToolset>v145</PlatformToolset>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.22621.0</WindowsTargetPlatformMinVersion>
    <CharacterSet>Unicode</CharacterSet>
    <PreferredToolArchitecture Condition="'$(PreferredToolArchitecture)' == ''">x64</PreferredToolArchitecture>
    <EnableASAN Condition="'$(EnableASAN)' == ''">false</EnableASAN>
    <EnableAnalyze Condition="'$(EnableAnalyze)' == ''">false</EnableAnalyze>
    <LinkIncremental Condition="'$(EnableASAN)' == 'true' Or '$(EnableAnalyze)' == 'true' Or '$(Configuration)' != 'Debug'">false</LinkIncremental>
    <!-- Compile flags (warning level, language standards, runtime) are
         ClCompile item metadata in VC projects, not properties; they live
         in Directory.Build.targets next to this file. -->
    <!-- An ASan or /analyze build has folders of its own, so switching between them and the plain build rebuilds nothing (D00 T04 §1, D06 T02 §10). -->
    <RectoBinFolder Condition="'$(EnableAnalyze)' == 'true'">bin-analyze</RectoBinFolder>
    <RectoBinFolder Condition="'$(EnableAnalyze)' != 'true' And '$(EnableASAN)' == 'true'">bin-asan</RectoBinFolder>
    <RectoBinFolder Condition="'$(EnableAnalyze)' != 'true' And '$(EnableASAN)' != 'true'">bin</RectoBinFolder>
    <RectoObjFolder Condition="'$(EnableAnalyze)' == 'true'">obj-analyze</RectoObjFolder>
    <RectoObjFolder Condition="'$(EnableAnalyze)' != 'true' And '$(EnableASAN)' == 'true'">obj-asan</RectoObjFolder>
    <RectoObjFolder Condition="'$(EnableAnalyze)' != 'true' And '$(EnableASAN)' != 'true'">obj</RectoObjFolder>
    <OutDir>$(MSBuildThisFileDirectory)build\$(RectoBinFolder)\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)build\$(RectoObjFolder)\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="($(MSBuildProjectName.StartsWith('recto-')) Or '$(MSBuildProjectName)' == 'Recto') And '$(EnableAnalyze)' == 'true'">
    <RunCodeAnalysis>true</RunCodeAnalysis>
    <EnableMicrosoftCodeAnalysis>true</EnableMicrosoftCodeAnalysis>
    <EnableCppCoreCheck>true</EnableCppCoreCheck>
    <UseMultiToolTask>true</UseMultiToolTask>
    <EnforceProcessCountAcrossBuilds>true</EnforceProcessCountAcrossBuilds>
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)build\RectoAnalyze.ruleset</CodeAnalysisRuleSet>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <CAExcludePath>$(MSBuildThisFileDirectory)vcpkg_installed;$(CAExcludePath)</CAExcludePath>
  </PropertyGroup>
  <PropertyGroup Condition="($(MSBuildProjectName.StartsWith('recto-')) Or '$(MSBuildProjectName)' == 'Recto') And '$(UseSccache)' == 'true'">
    <UseMultiToolTask>true</UseMultiToolTask>
    <EnforceProcessCountAcrossBuilds>true</EnforceProcessCountAcrossBuilds>
  </PropertyGroup>
</Project>
