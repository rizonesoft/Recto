<?xml version="1.0" encoding="utf-8"?>
<!-- Recto's MSBuild wiring for the pinned MuPDF win32 projects. Pass to
     msbuild as /p:CustomAfterMicrosoftCommonTargets=<this file> when
     building third_party/mupdf/platform/win32 projects; the Recto solution
     (D00 T01 section 3) imports it the same way. Nothing in the submodule
     is modified: the pin stays reproducible from the upstream tag.

     Why this exists (found at pin time, MuPDF 1.28.5): the upstream win32
     libthirdparty.vcxproj always compiles the MuJS unity file
     thirdparty/mujs/one.c; it has no project-level switch for D12's
     JavaScript-off, unlike the Makefile (mujs=no adds -DFZ_ENABLE_JS=0 and
     drops the objects). Recto does the same two things from its own side:
     mupdf-config.h defines FZ_ENABLE_JS 0 (forced include), and this file
     removes the MuJS unity file from libthirdparty's compile list, so no
     JavaScript objects are produced at all. The thirdparty/mujs submodule
     stays uninitialized: if this removal ever stops working, the build
     fails loudly on the missing source instead of silently shipping MuJS. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="RectoRemoveMuJsUnityFile" BeforeTargets="ClCompile"
          Condition="'$(MSBuildProjectName)' == 'libthirdparty'">
    <ItemGroup>
      <ClCompile Remove="..\..\thirdparty\mujs\one.c" />
      <!-- MSBuild Remove of a non-matching path is silent, so assert on what
           remains: any MuJS compile item still present after the removal
           (an upstream rename on a future pin bump, or a wiring mistake)
           fails the build here instead of quietly shipping MuJS. -->
      <_RectoMuJsLeftovers Include="@(ClCompile)"
                           Condition="$([System.String]::Copy('%(ClCompile.Identity)').ToLowerInvariant().Contains('mujs'))" />
    </ItemGroup>
    <Error Condition="'@(_RectoMuJsLeftovers)' != ''"
           Text="Recto: MuJS sources are still in libthirdparty's compile list after the D12 exclusion (@(_RectoMuJsLeftovers)). Fix build/mupdf-win32.targets for this MuPDF pin; do not build with JavaScript." />
  </Target>
</Project>
