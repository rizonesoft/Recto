<?xml version="1.0" encoding="utf-8"?>
<!-- ClCompile defaults for all Recto projects. VC compile settings are
     item metadata, and Directory.Build.targets is imported after the
     toolset defaults, so these win. -->
<Project>
  <PropertyGroup Condition="($(MSBuildProjectName.StartsWith('recto-')) Or '$(MSBuildProjectName)' == 'Recto') And '$(EnableASAN)' == 'true'">
    <LinkIncremental>false</LinkIncremental>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="$(MSBuildProjectName.StartsWith('recto-')) Or '$(MSBuildProjectName)' == 'Recto'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <UseStandardPreprocessor>true</UseStandardPreprocessor>
      <AdditionalOptions>%(AdditionalOptions) /utf-8</AdditionalOptions>
      <SDLCheck Condition="'$(Configuration)' != 'Debug'">true</SDLCheck>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)' != 'Debug'">MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="($(MSBuildProjectName.StartsWith('recto-')) Or '$(MSBuildProjectName)' == 'Recto') And '$(EnableASAN)' == 'true' And '$(Platform)' == 'x64'">
    <ClCompile>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <WholeProgramOptimization>false</WholeProgramOptimization>
      <AdditionalOptions>%(AdditionalOptions) /fsanitize=address</AdditionalOptions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <LinkIncremental>false</LinkIncremental>
      <LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>
    </Link>
  </ItemDefinitionGroup>
  <!-- Two library folders the toolset's default LibraryPath always names, ATL/MFC and the .NET Framework 4.8 libraries
       for the platform, are dropped when they are not installed (on ARM64 they usually are not): Recto links neither.
       SetBuildDefaultEnvironmentVariables copies LibraryPath into LIB, and an absent folder there made the C# compiler
       behind vcpkg's inline MSBuild tasks warn CS1668 (D06 T05 §27). Only these two defaults are touched; any other
       entry, present or not, stays, so a mistyped library folder still shows. This runs just before LIB is set. -->
  <PropertyGroup>
    <SetBuildDefaultEnvironmentVariablesDependsOn>$(SetBuildDefaultEnvironmentVariablesDependsOn);RectoDropAbsentUnusedLibraryPaths</SetBuildDefaultEnvironmentVariablesDependsOn>
  </PropertyGroup>
  <Target Name="RectoDropAbsentUnusedLibraryPaths">
    <ItemGroup>
      <_RectoUnusedLibraryPath Condition="'$(PlatformTarget)' == 'ARM64'" Include="$(VC_LibraryPath_ATL_ARM64)" />
      <_RectoUnusedLibraryPath Condition="'$(PlatformTarget)' == 'x64'" Include="$(VC_LibraryPath_ATL_x64)" />
      <_RectoUnusedLibraryPath Include="$(NETFXKitsDir)lib\um\$(PlatformTarget.ToLowerInvariant())" />
      <_RectoAbsentLibraryPath Include="@(_RectoUnusedLibraryPath)" Condition="!Exists('%(Identity)')" />
      <_RectoLibraryPath Include="$(LibraryPath)" />
      <_RectoLibraryPath Remove="@(_RectoAbsentLibraryPath)" />
    </ItemGroup>
    <PropertyGroup>
      <LibraryPath>@(_RectoLibraryPath)</LibraryPath>
    </PropertyGroup>
    <ItemGroup>
      <_RectoUnusedLibraryPath Remove="@(_RectoUnusedLibraryPath)" />
      <_RectoAbsentLibraryPath Remove="@(_RectoAbsentLibraryPath)" />
      <_RectoLibraryPath Remove="@(_RectoLibraryPath)" />
    </ItemGroup>
  </Target>
</Project>
