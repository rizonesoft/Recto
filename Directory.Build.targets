<?xml version="1.0" encoding="utf-8"?>
<!-- ClCompile defaults for all Recto projects. VC compile settings are
     item metadata, and Directory.Build.targets is imported after the
     toolset defaults, so these win. -->
<Project>
  <PropertyGroup Condition="($(MSBuildProjectName.StartsWith('recto-')) Or '$(MSBuildProjectName)' == 'Recto') And '$(EnableASAN)' == 'true'">
    <LinkIncremental>false</LinkIncremental>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="$(MSBuildProjectName.StartsWith('recto-')) Or '$(MSBuildProjectName)' == 'Recto'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <ConformanceMode>true</ConformanceMode>
      <!-- stdcpp23 is /std:c++23preview: MSVC 14.51 ships no stable /std:c++23 (D14, 2026-10-22). Move to the
           stable C++23 or C++26 switch as soon as MSVC ships one. -->
      <LanguageStandard>stdcpp23</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <UseStandardPreprocessor>true</UseStandardPreprocessor>
      <AdditionalOptions>%(AdditionalOptions) /utf-8</AdditionalOptions>
      <SDLCheck Condition="'$(Configuration)' != 'Debug'">true</SDLCheck>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)' != 'Debug'">MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- The module libraries on either side of the D13 boundary have cl write, for each source, a JSON report of every
       file it opened (/sourceDependencies, into IntDir). scripts/check-ui-boundary.py reads those reports after the
       build (build/build.ps1 runs it): they are the proof that no engine source opened a recto-ui file and no recto-ui
       source an engine file, whatever spelling an include, a forced include or an option uses (D10 T01 §1). -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'recto-pdf' Or '$(MSBuildProjectName)' == 'recto-core' Or '$(MSBuildProjectName)' == 'recto-services' Or '$(MSBuildProjectName)' == 'recto-ui'">
    <ClCompile>
      <GenerateSourceDependencies>true</GenerateSourceDependencies>
      <SourceDependenciesFile>$(IntDir)</SourceDependenciesFile>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- After ClCompile, each module project records what it compiled and with which settings: every ClCompile item with
       the metadata cl was given (whatever a target changed before compiling), its IntDir and its library. The boundary
       check reads this record instead of re-evaluating the project, so it checks the build that ran (D10 T01 §1).
       build/build.ps1 empties build\boundary\<platform>\<configuration> before each configuration. -->
  <Target Name="RectoBoundaryManifest" AfterTargets="ClCompile" Condition="'$(MSBuildProjectName)' == 'recto-pdf' Or '$(MSBuildProjectName)' == 'recto-core' Or '$(MSBuildProjectName)' == 'recto-services' Or '$(MSBuildProjectName)' == 'recto-ui'">
    <ItemGroup>
      <_RectoBoundaryLine Include="project|$(MSBuildProjectFullPath)|$(IntDir)|$(OutDir)$(TargetName)$(TargetExt)" />
      <_RectoBoundaryLine Include="@(ClCompile->'unit|%(FullPath)|%(ExcludedFromBuild)|%(GenerateSourceDependencies)|%(SourceDependenciesFile)|%(ObjectFileName)|%(PrecompiledHeader)|%(PrecompiledHeaderOutputFile)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(MSBuildThisFileDirectory)build\boundary\$(Platform)\$(Configuration)\$(MSBuildProjectName).txt" Lines="@(_RectoBoundaryLine)" Overwrite="true" />
    <ItemGroup>
      <_RectoBoundaryLine Remove="@(_RectoBoundaryLine)" />
    </ItemGroup>
  </Target>
  <ItemDefinitionGroup Condition="($(MSBuildProjectName.StartsWith('recto-')) Or '$(MSBuildProjectName)' == 'Recto') And '$(EnableASAN)' == 'true' And '$(Platform)' == 'x64'">
    <ClCompile>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <WholeProgramOptimization>false</WholeProgramOptimization>
      <AdditionalOptions>%(AdditionalOptions) /fsanitize=address</AdditionalOptions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <LinkIncremental>false</LinkIncremental>
      <LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>
    </Link>
  </ItemDefinitionGroup>
  <!-- Two library folders the toolset's default LibraryPath always names, ATL/MFC and the .NET Framework 4.8 libraries
       for the platform, are dropped when they are not installed (on ARM64 they usually are not): Recto links neither.
       SetBuildDefaultEnvironmentVariables copies LibraryPath into LIB, and an absent folder there made the C# compiler
       behind vcpkg's inline MSBuild tasks warn CS1668 (D06 T05 §27). Only these two defaults are touched; any other
       entry, present or not, stays, so a mistyped library folder still shows. This runs just before LIB is set. -->
  <PropertyGroup>
    <SetBuildDefaultEnvironmentVariablesDependsOn>$(SetBuildDefaultEnvironmentVariablesDependsOn);RectoDropAbsentUnusedLibraryPaths</SetBuildDefaultEnvironmentVariablesDependsOn>
  </PropertyGroup>
  <Target Name="RectoDropAbsentUnusedLibraryPaths">
    <ItemGroup>
      <_RectoUnusedLibraryPath Condition="'$(PlatformTarget)' == 'ARM64'" Include="$(VC_LibraryPath_ATL_ARM64)" />
      <_RectoUnusedLibraryPath Condition="'$(PlatformTarget)' == 'x64'" Include="$(VC_LibraryPath_ATL_x64)" />
      <_RectoUnusedLibraryPath Include="$(NETFXKitsDir)lib\um\$(PlatformTarget.ToLowerInvariant())" />
      <_RectoAbsentLibraryPath Include="@(_RectoUnusedLibraryPath)" Condition="!Exists('%(Identity)')" />
      <_RectoLibraryPath Include="$(LibraryPath)" />
      <_RectoLibraryPath Remove="@(_RectoAbsentLibraryPath)" />
    </ItemGroup>
    <PropertyGroup>
      <LibraryPath>@(_RectoLibraryPath)</LibraryPath>
    </PropertyGroup>
    <ItemGroup>
      <_RectoUnusedLibraryPath Remove="@(_RectoUnusedLibraryPath)" />
      <_RectoAbsentLibraryPath Remove="@(_RectoAbsentLibraryPath)" />
      <_RectoLibraryPath Remove="@(_RectoLibraryPath)" />
    </ItemGroup>
  </Target>
</Project>
